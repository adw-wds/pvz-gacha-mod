<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       深色玻璃（glassmorphism）+ 柔和景深
       窗口本身是毛玻璃，所以卡片用「半透明白 + 极细亮边 + 软阴影」，
       让层次来自透明度而不是同色浮雕 —— 这样压在模糊背景上才通透。
       所有交互态都带动画（颜色渐变 / 位移 / 缩放），不要硬切。
       ============================================================ -->

  <FontFamily x:Key="AppFont">Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="NumFont">Consolas</FontFamily>

  <!-- 强调色：柔绿，和游戏菜单的绿色调呼应 -->
  <Color x:Key="AccentColor">#4ADE80</Color>
  <Color x:Key="AccentDeepColor">#22C55E</Color>
  <Color x:Key="WarnColor">#FB7185</Color>

  <SolidColorBrush x:Key="BgBrush"        Color="#F21A1D24"/>
  <SolidColorBrush x:Key="PanelBrush"     Color="#0DFFFFFF"/>
  <SolidColorBrush x:Key="CardBrush"      Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="CardHiBrush"    Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="SunkenBrush"    Color="#33000000"/>
  <!-- ★★ 已迁移到浅色皮肤：这几个值原本是为【深色底】设计的（近白 / 浅灰 / 半透明白线），
       留在合并字典里会把文字染成近白色，压在白色卡片上直接看不清。
       现在统一改成深色 —— 浅底深字。 -->
  <SolidColorBrush x:Key="TextBrush"      Color="#1A1A1A"/>
  <SolidColorBrush x:Key="SubTextBrush"   Color="#5F5F5F"/>
  <SolidColorBrush x:Key="AccentBrush"    Color="#4ADE80"/>
  <SolidColorBrush x:Key="AccentDimBrush" Color="#264D38"/>
  <SolidColorBrush x:Key="WarnBrush"      Color="#C42B1C"/>
  <SolidColorBrush x:Key="LineBrush"      Color="#22000000"/>

  <!-- 动画时长：短、快、不拖沓 -->
  <Duration x:Key="Fast">0:0:0.14</Duration>
  <Duration x:Key="Normal">0:0:0.22</Duration>
  <Duration x:Key="Slow">0:0:0.36</Duration>

  <CubicEase x:Key="OutEase" EasingMode="EaseOut"/>
  <BackEase x:Key="PopEase" EasingMode="EaseOut" Amplitude="0.4"/>

  <DropShadowEffect x:Key="SoftShadow" Color="#000000" Opacity="0.45" BlurRadius="18" ShadowDepth="4" Direction="270"/>
  <DropShadowEffect x:Key="DeepShadow" Color="#000000" Opacity="0.55" BlurRadius="26" ShadowDepth="8" Direction="270"/>

  <!-- ================================================================ 文字 -->

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ================================================================ 卡片 -->

  <Style x:Key="GlassCard" TargetType="ContentControl">
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <!-- 不画描边：相邻卡片的 1px 边会连成双线，看着像「缝隙」。层次全部交给阴影。 -->
          <Border x:Name="face" CornerRadius="14"
                  Background="{StaticResource CardBrush}"
                  BorderThickness="0"
                  Padding="{TemplateBinding Padding}"
                  Effect="{StaticResource SoftShadow}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <TranslateTransform x:Name="slide"/>
            </Border.RenderTransform>
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="{StaticResource Normal}"/>
                    <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="Y"
                                     From="12" To="0" Duration="{StaticResource Slow}" EasingFunction="{StaticResource OutEase}"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SunkenBox" TargetType="ContentControl">
    <Setter Property="Padding" Value="11,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border CornerRadius="10" Background="#26000000"
                  BorderBrush="#12FFFFFF" BorderThickness="1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ 按钮 -->

  <Style x:Key="GlassButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="15,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="face" CornerRadius="10"
                  Background="{StaticResource CardBrush}"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="Background.Color"
                                    To="#1FFFFFFF" Duration="{StaticResource Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                     To="1.025" Duration="{StaticResource Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                     To="1.025" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="Background.Color"
                                    To="#12FFFFFF" Duration="{StaticResource Normal}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="{StaticResource Normal}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="{StaticResource Normal}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                     To="0.97" Duration="0:0:0.06"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                     To="0.97" Duration="0:0:0.06"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="face" Property="Opacity" Value="0.35"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource GlassButton}"/>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Foreground" Value="#08210F"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="face" CornerRadius="10" Background="{StaticResource AccentBrush}"
                  Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                     To="1.03" Duration="{StaticResource Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                     To="1.03" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="{StaticResource Normal}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="{StaticResource Normal}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 左侧导航：选中时左侧亮条滑出 + 底色渐显 -->
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="16,11"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="FontSize" Value="13.5"/>
  </Style>

  <Style x:Key="NavActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- 标题栏小圆钮（最小化/关闭）：用普通文字字体，避开字形缺字变成空心方框的问题 -->
  <Style x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="face" CornerRadius="8" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="#1FFFFFFF"/>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ 开关
       滑块用 TranslateTransform 做位移动画，带 Q 弹缓动 —— 这是"动效"最直接的体现。 -->

  <Style x:Key="GlassSwitch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Width="52" Height="28" Background="Transparent">
            <Border x:Name="track" CornerRadius="14" Background="#26000000"
                    BorderBrush="#1FFFFFFF" BorderThickness="1"/>
            <Border x:Name="knob" Width="20" Height="20" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                    Background="#7A8899" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <TranslateTransform x:Name="knobShift" X="0"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="5" ShadowDepth="1"/>
              </Border.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="knobShift" Storyboard.TargetProperty="X"
                                     To="24" Duration="{StaticResource Normal}" EasingFunction="{StaticResource PopEase}"/>
                    <ColorAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Background.Color"
                                    To="{StaticResource AccentColor}" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="knobShift" Storyboard.TargetProperty="X"
                                     To="0" Duration="{StaticResource Normal}" EasingFunction="{StaticResource OutEase}"/>
                    <ColorAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Background.Color"
                                    To="#7A8899" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="track" Property="Background" Value="#33000000"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ 分段按钮
       点一下选一个，用户不需要输数字。选中时底色渐显 + 微弱放大。 -->

  <Style x:Key="Segment" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Margin" Value="0,0,7,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="face" CornerRadius="9" Padding="14,8"
                  Background="#0DFFFFFF"
                  BorderBrush="#14FFFFFF" BorderThickness="1"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="Background.Color"
                                    To="#1FFFFFFF" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="Background.Color"
                                    To="#0DFFFFFF" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="Background.Color"
                                    To="#334ADE80" Duration="{StaticResource Fast}"/>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="BorderBrush.Color"
                                    To="{StaticResource AccentColor}" Duration="{StaticResource Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                     To="1.04" Duration="{StaticResource Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                     To="1.04" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="Background.Color"
                                    To="#0DFFFFFF" Duration="{StaticResource Fast}"/>
                    <ColorAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="BorderBrush.Color"
                                    To="#14FFFFFF" Duration="{StaticResource Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="{StaticResource Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="{StaticResource Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 商品/槽位小磁贴 -->
  <Style x:Key="Tile" TargetType="ToggleButton" BasedOn="{StaticResource Segment}">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
  </Style>

  <!-- ================================================================ 输入 -->

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#26000000"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" CornerRadius="9"
                  BorderBrush="#14FFFFFF" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- 细滚动条，悬停才明显 -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

</ResourceDictionary>
